# ------------------------------------------------------------------
# Copy to .env (development), .env.test (docker-compose.test.yml) or
# .env.production (docker-compose.prod.yml) and adjust the values.
# ------------------------------------------------------------------

# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# --- Database (MySQL) ---
# Runtime: the Prisma MariaDB adapter uses DATABASE_HOST/PORT/USER/PASSWORD/NAME.
# CLI: prisma migrate / studio read DATABASE_URL (see prisma.config.ts).
# Keep both pointing at the SAME database.
#
# Values below target the Docker dev stack (service "mysql-dev").
# Running the app on your host instead of Docker? Use:
#   DATABASE_HOST=localhost  DATABASE_PORT=3307
#   DATABASE_URL=mysql://root:mypassword@localhost:3307/app_db
DATABASE_HOST=mysql-dev
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=mypassword
DATABASE_NAME=app_db
DATABASE_CONNECTION_LIMIT=5
DATABASE_URL=mysql://root:mypassword@mysql-dev:3306/app_db

# --- Redis (optional - leave empty to disable) ---
# e.g. redis://localhost:6379
REDIS_URL=

# --- Cloudinary (optional - leave empty to disable) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
