{
    "name": "modular-layer-architecture",
    "version": "1.0.0",
    "description": "Reusable Node.js + Express + TypeScript REST API starter built on a feature-based Modular Layered Architecture (Prisma v7 + MySQL).",
    "keywords": [
        "nodejs",
        "express",
        "typescript",
        "prisma",
        "mysql",
        "starter",
        "template",
        "modular-architecture"
    ],
    "license": "ISC",
    "author": "Mustafa Ahmed",
    "type": "module",
    "main": "./dist/server.js",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "predev": "prisma generate",
        "dev": "tsx watch src/server.ts",
        "build": "prisma generate && tsc",
        "start": "node dist/server.js",
        "prod": "node dist/server.js",
        "typecheck": "tsc -p tsconfig.test.json",
        "pretypecheck": "prisma generate",
        "pretest": "prisma generate",
        "test": "vitest run",
        "test:unit": "vitest run unit/",
        "test:integration": "vitest run integration/",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prisma:generate": "prisma generate",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:migrate:create": "prisma migrate dev --create-only",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:migrate:status": "prisma migrate status",
        "prisma:studio": "prisma studio",
        "commit": "node --loader ts-node/esm scripts/generate-commit.ts",
        "docker:dev:build": "docker compose -f docker-compose.dev.yml build",
        "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
        "docker:dev:up:build": "docker compose -f docker-compose.dev.yml up -d --build",
        "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
        "docker:dev:restart": "docker compose -f docker-compose.dev.yml restart",
        "docker:dev:rebuild": "docker compose -f docker-compose.dev.yml build --no-cache && docker compose -f docker-compose.dev.yml up -d --force-recreate",
        "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f app-dev",
        "docker:dev:ps": "docker compose -f docker-compose.dev.yml ps",
        "docker:dev:shell": "docker compose -f docker-compose.dev.yml exec app-dev bash",
        "docker:dev:migrate": "docker compose -f docker-compose.dev.yml exec app-dev npx prisma migrate dev",
        "docker:test:up": "docker compose -f docker-compose.test.yml up -d",
        "docker:test:up:build": "docker compose -f docker-compose.test.yml up -d --build",
        "docker:test:down": "docker compose -f docker-compose.test.yml down",
        "docker:test:logs": "docker compose -f docker-compose.test.yml logs -f app-test",
        "docker:build": "docker compose -f docker-compose.build.yml build",
        "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
        "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
        "docker:prod:up:build": "docker compose -f docker-compose.prod.yml up -d --build",
        "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
        "docker:prod:restart": "docker compose -f docker-compose.prod.yml restart",
        "docker:prod:rebuild": "docker compose -f docker-compose.prod.yml build --no-cache && docker compose -f docker-compose.prod.yml up -d --force-recreate",
        "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f app",
        "docker:prod:ps": "docker compose -f docker-compose.prod.yml ps",
        "docker:config": "docker compose -f docker-compose.dev.yml config --quiet && docker compose -f docker-compose.test.yml config --quiet && docker compose -f docker-compose.prod.yml config --quiet && docker compose -f docker-compose.build.yml config --quiet"
    },
    "dependencies": {
        "@prisma/adapter-mariadb": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "cloudinary": "^2.7.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.1.0",
        "http-status-codes": "^2.3.0",
        "ioredis": "^5.6.1",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.15.0",
        "@types/supertest": "^6.0.3",
        "@vitest/coverage-v8": "^3.2.7",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.9",
        "prisma": "^7.10.0",
        "supertest": "^7.3.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^3.2.7"
    }
}
